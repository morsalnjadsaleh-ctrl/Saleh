class Pa5xHardwareMidiDriver(
    private val context: Context,
    private val audioEngine: OboeAudioEngine,
    private val scaleManager: Pa5xScaleManager
) {
    private var midiManager: MidiManager? = context.getSystemService(Context.MIDI_SERVICE) as? MidiManager
    private var openMidiDevice: MidiDevice? = null

    init {
        scanAndConnectMidiDevices()
    }

    /**
     * ۱. اسکن پورت‌های سخت‌افزاری و اتصال خودکار و هوشمند به کیبوردهای فیزیکی متصل شده با کابل
     */
    fun scanAndConnectMidiDevices() {
        val manager = midiManager ?: return
        val infos = manager.devices
        for (info in infos) {
            manager.openDevice(info, { device ->
                if (device != null) {
                    openMidiDevice = device
                    // باز کردن آنی پورت خروجی شماره 0 ارگ فیزیکی متصل شده
                    val outputPort = device.openOutputPort(0)
                    outputPort?.connect(KorgMidiReceiver())
                    Log.i("Pa5XMidi", "اتصال سخت‌افزاری به کیبورد فیزیکی برقرار شد: ${info.properties.getString(MidiDeviceInfo.PROPERTY_NAME)}")
                }
            }, Handler(Looper.getMainLooper()))
        }
    }
/**
 * شبیه‌ساز لغزنده‌های لایه گرافیکی برای برش زنده تکه‌ای از ملودی فایل آهنگ
 */
fun OboeAudioEngine.trimAndLoadMelodyChunk(
    sourceAudio: FloatArray,
    startFrame: Int,
    endFrame: Int,
    playbackSpeed: Float,
    scaleManager: Pa5xScaleManager
) {
    kotlin.concurrent.thread(start = true, name = "VivaMelodyTrimmer") {
        try {
            if (startFrame < 0 || endFrame >= sourceAudio.size || startFrame >= endFrame) return@thread

            val requestedLength = endFrame - startFrame
            val targetBuffer = FloatArray(requestedLength * 2)

            // شبیه‌سازی انتقال بایت به بایت قطعه برش‌خورده ملودی صوتی
            System.arraycopy(sourceAudio, startFrame * 2, targetBuffer, 0, requestedLength * 2)

            // پمپ کردن مستقیم سیگنال ملودی به بافر آنالیزور فاز ۵
            val detectedNote = this.processAudioForScale(targetBuffer, targetBuffer.size)
            
            // روشن کردن کلاویه نوری متناظر روی بدنه Pa5X به صورت زنده
            if (detectedNote > 0) {
                scaleManager.updateLivePlayingLight(detectedNote)
            }
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }
}
