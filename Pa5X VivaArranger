class Pa5xKsfLoader {
public:
    // ۲. متد لود دیتای خام صوتی ۳۲ بیتی اعشاری از درون فایل فشرده .KSF کرگ
    float* loadKsfAudioData(const std::string& ksfPath, KorgKsfHeader& outHeader) {
        std::ifstream file(ksfPath, std::ios::binary);
        if (!file.is_open()) return nullptr;

        // خواندن هدر باینری فایل KSF برای استخراج نقاط لوپ دم صدا
        file.read(reinterpret_cast<char*>(&outHeader), sizeof(KorgKsfHeader));
        if (std::strncmp(&outHeader.magic, "KSF", 3) != 0) {
            file.close();
            return nullptr;
        }

        // تخصیص مستقیم حافظه در رم بومی (Native Memory) بدون سربار سیستم اندروید
        int32_t totalSamples = outHeader.sampleLen / sizeof(int16_t); // دیتای کرگ ۱۶ بیتی کوانتیزه است
        float* floatBuffer = new float[totalSamples];
        
        std::vector<int16_t> temp16BitBuffer(totalSamples);
        file.read(reinterpret_cast<char*>(temp16BitBuffer.data()), outHeader.sampleLen);
        file.close();
        // تبدیل ریل‌تایم و فوق‌سریع سیگنال ۱۶ بیتی به ۳2 بیتی اعشاری مجهز به شتاب‌دهنده Neon
        for (int32_t i = 0; i < totalSamples; ++i) {
            floatBuffer[i] = static_cast<float>(temp16BitBuffer[i]) / 32768.0f;
        }

        return floatBuffer;
    }
};

static Pa5xKsfLoader* gKsfLoaderInstance = nullptr;

extern "C" {
    JNIEXPORT void JNICALL Java_com_example_audio_oboe_OboeAudioEngine_initKmpParser(JNIEnv* env, jobject thiz) {
        if (gKmpParserInstance == nullptr) gKmpParserInstance = new Pa5xKmpParser();
        if (gKsfLoaderInstance == nullptr) gKsfLoaderInstance = new Pa5xKsfLoader();
    }

    // متد پُل ارتباطی JNI جهت فراخوانی مالتی‌سمپل کرگ از روی حافظه گوشی توسط کاربر
    JNIEXPORT jboolean JNICALL Java_com_example_audio_oboe_OboeAudioEngine_loadDirectKmpInstrument(
        JNIEnv* env, jobject thiz, jstring jKmpPath, jstring jKsfFolder) {
        
        if (!gKmpParserInstance || !gKsfLoaderInstance || !korgEngineInstance) return JNI_FALSE;

        const char* nativeKmpPath = env->GetStringUTFChars(jKmpPath, nullptr);
        const char* nativeKsfFolder = env->GetStringUTFChars(jKsfFolder, nullptr);
        
        std::string kmpPath(nativeKmpPath);
        std::string ksfFolder(nativeKsfFolder);
        
        env->ReleaseStringUTFChars(jKmpPath, nativeKmpPath);
        env->ReleaseStringUTFChars(jKsfFolder, nativeKsfFolder);

        // ۱. پارس کردن نقشه اسپلیت‌های ساز
        if (!gKmpParserInstance->parseKmpFile(kmpPath)) return JNI_FALSE;

        // ۲. لوپ زدن روی تک‌تک نت‌ها و لود کردن خودکار فایل‌های KSF متناظر به رم بومی C++
        for (const auto& split : gKmpParserInstance->mSplits) {
            std::string fullKsfPath = ksfFolder + "/" + std::string(split.ksfFileName);
            KorgKsfHeader ksfHeader;
            
            float* audioPayload = gKsfLoaderInstance->loadKsfAudioData(fullKsfPath, ksfHeader);
            if (audioPayload != nullptr) {
                int32_t sampleCount = ksfHeader.sampleLen / sizeof(int16_t);
                bool doLoop = (ksfHeader.loopFlags & 0x01) != 0;

                // تزریق آنی ساز به ماتریس پولیفونی فاز ۱ بر اساس دامنه نت‌های مجاز (LowNote تا HighNote)
                for (int32_t note = split.lowNote; note <= split.highNote; ++note) {
                    korgEngineInstance->allocationVoiceTrigger(
                        audioPayload, sampleCount, 0, note, 1.0f, doLoop, ksfHeader.loopStart, ksfHeader.loopEnd
                    );
                }
            }
        }

        return JNI_TRUE;
    }
}
