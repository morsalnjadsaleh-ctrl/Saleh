class Pa5xAdvancedEngine : public oboe::AudioStreamCallback {
public:
    ActiveVoice mVoicePool[MAX_POLYPHONY]; ChannelStrip mChannels[TOTAL_CHANNELS]; std::atomic<float> mOrientalTuningCents[MATRIX_NOTE_COUNT]; std::atomic<float> mPitchBendHardware{0.0f}; std::shared_ptr<oboe::AudioStream> mStream;
    Pa5xAdvancedEngine() { for (int i = 0; i < MATRIX_NOTE_COUNT; ++i) mOrientalTuningCents[i].store(0.0f); for (int i = 0; i < MAX_POLYPHONY; ++i) mVoicePool[i].inUse.store(false); }
    void startStream() { oboe::AudioStreamBuilder b; b.setDirection(oboe::Direction::Output)->setPerformanceMode(oboe::PerformanceMode::LowLatency)->setSharingMode(oboe::SharingMode::Exclusive)->setFormat(oboe::AudioFormat::Float)->setChannelCount(oboe::ChannelCount::Stereo)->setCallback(this)->openStream(mStream); if (mStream) mStream->requestStart(); }
