#include <atomic>
#include <cmath>
#include <algorithm>
#include <cstring>
#include <vector>
#include <ctime>

constexpr int32_t MAX_POLYPHONY = 64;   
constexpr int32_t TOTAL_CHANNELS = 4;   
constexpr int32_t MATRIX_NOTE_COUNT = 12;
constexpr float AMBIENT_SAMPLE_RATE = 44100.0f;
constexpr float GAIN_SMOOTHING_FACTOR = 0.005f; 
struct PCMAsset {
    float* pcmBuffer = nullptr;
    int32_t totalSamples = 0;
};

struct ActiveVoice {
    PCMAsset sample;
    float readIndex = 0.0f;
    float pitchRatio = 1.0f;
    int32_t targetChannel = 0;
    int32_t midiNote = 60;
    bool isLooping = false;
    int32_t loopStart = 0;
    int32_t loopEnd = 0;
    std::atomic<bool> inUse{false};
    float currentReleaseGain = 1.0f;
    bool isReleased = false;
};

struct ChannelStrip {
    std::atomic<float> targetGain{1.0f};
    float currentGain = 1.0f; 
    std::atomic<bool> mute{false};
};

struct ChordSpecs {
    int32_t rootNote = 0;
    int32_t chordType = 0;
};

class Pa5xPitchDetector {
public:
    float detectFundamentalFrequency(const float* buffer, int32_t bufferSize) {
        int32_t maxLag = static_cast<int32_t>(AMBIENT_SAMPLE_RATE / 65);
        int32_t minLag = static_cast<int32_t>(AMBIENT_SAMPLE_RATE / 1046);
        float maxCorrelation = -1.0f;
        int32_t bestLag = -1;
        for (int32_t lag = minLag; lag < maxLag; ++lag) {
            float correlationSum = 0.0f;
            for (int32_t i = 0; i < bufferSize - lag; ++i) {
                correlationSum += buffer[i] * buffer[i + lag];
            }
            if (correlationSum > maxCorrelation) {
                maxCorrelation = correlationSum;
                bestLag = lag;
            }
        }
        return (bestLag > -1 && maxCorrelation > 0.1f) ? (AMBIENT_SAMPLE_RATE / bestLag) : 0.0f;
    }
    int32_t convertHzToMidiNote(float frequency) {
        if (frequency <= 0.0f) return -1;
        return static_cast<int32_t>(std::round(12.0f * std::log2(frequency / 440.0f) + 69.0f));
    }
};

class Pa5xSmartDrummer {
public:
    std::atomic<int32_t> mCurrentBpm{120};
    std::atomic<int32_t> mCurrentVariation{1};
    std::atomic<bool> mIsStylePlaying{false};
    std::atomic<int32_t> mRightHandNoteCount{0};
    unsigned long long mLastNoteTimestamp = 0;
    ChordSpecs mDetectedChord;

    void notifyRightHandStrike(float velocity) {
        struct timespec ts;
        clock_gettime(CLOCK_MONOTONIC, &ts);
        unsigned long long currentMillis = (ts.tv_sec * 1000LL) + (ts.tv_nsec / 1000000LL);
        if (currentMillis - mLastNoteTimestamp < 250) {
            mRightHandNoteCount.store(mRightHandNoteCount.load() + 1, std::memory_order_relaxed);
        } else {
            mRightHandNoteCount.store(1, std::memory_order_relaxed);
        }
        mLastNoteTimestamp = currentMillis;
    }
};

class Pa5xAdvancedEngine {
public:
    ActiveVoice mVoicePool[MAX_POLYPHONY];
    ChannelStrip mChannels[TOTAL_CHANNELS];
    std::atomic<float> mOrientalTuningCents[MATRIX_NOTE_COUNT];
    std::atomic<float> mPitchBendHardware{0.0f};
    Pa5xAdvancedEngine() {
        for (int i = 0; i < MATRIX_NOTE_COUNT; ++i) mOrientalTuningCents[i].store(0.0f);
        for (int i = 0; i < MAX_POLYPHONY; ++i) mVoicePool[i].inUse.store(false);
    }

    void allocationVoiceTrigger(float* buffer, int32_t length, int32_t channel, int32_t note, float velocity, bool loop, int32_t lStart, int32_t lEnd) {
        int32_t targetIndex = -1;
        for (int i = 0; i < MAX_POLYPHONY; ++i) {
            if (!mVoicePool[i].inUse.load(std::memory_order_relaxed)) {
                targetIndex = i;
                break;
            }
        }
        if (targetIndex == -1) targetIndex = 0; 
        ActiveVoice& voice = mVoicePool[targetIndex];
        voice.sample.pcmBuffer = buffer;
        voice.sample.totalSamples = length;
        voice.readIndex = 0.0f;
        voice.targetChannel = channel;
        voice.midiNote = note;
        voice.isLooping = loop;
        voice.loopStart = lStart;
        voice.loopEnd = lEnd;
        voice.isReleased = false;
        voice.currentReleaseGain = 1.0f;
        voice.pitchRatio = std::pow(2.0f, (note - 60) / 12.0f) * velocity;
        voice.inUse.store(true, std::memory_order_release);
    }
};

static Pa5xAdvancedEngine* korgEngineInstance = nullptr;
static Pa5xPitchDetector* gPitchDetector = nullptr;
static Pa5xSmartDrummer* gDrummerInstance = nullptr;

extern "C" {
    JNIEXPORT void JNICALL Java_com_example_audio_oboe_OboeAudioEngine_initEngine(JNIEnv* env, jobject thiz) {
        if (korgEngineInstance == nullptr) {
            korgEngineInstance = new Pa5xAdvancedEngine();
            gPitchDetector = new Pa5xPitchDetector();
            gDrummerInstance = new Pa5xSmartDrummer();
        }
    }
    JNIEXPORT void JNICALL Java_com_example_audio_oboe_OboeAudioEngine_setChannelVol(JNIEnv* env, jobject thiz, jint chId, jfloat vol) {
        if (korgEngineInstance && chId < TOTAL_CHANNELS) korgEngineInstance->mChannels[chId].targetGain.store(vol, std::memory_order_relaxed);
    }
    JNIEXPORT void JNICALL Java_com_example_audio_oboe_OboeAudioEngine_triggerNativeSample(JNIEnv* env, jobject thiz, jint ch, jfloatArray arr, jint len, jint note, jfloat velocity, jboolean lp, jint start, jint end) {
        if (!korgEngineInstance) return;
        jfloat* rawArray = env->GetFloatArrayElements(arr, nullptr);
        float* persistentMemory = new float[len];
        std::memcpy(persistentMemory, rawArray, len * sizeof(float));
        env->ReleaseFloatArrayElements(arr, rawArray, JNI_ABORT);
        korgEngineInstance->allocationVoiceTrigger(persistentMemory, len, ch, note, velocity, lp, start, end);
    }
    JNIEXPORT void JNICALL Java_com_example_audio_oboe_OboeAudioEngine_updateJoystickHardware(JNIEnv* env, jobject thiz, jfloat x, jfloat y) {
        if (korgEngineInstance) korgEngineInstance->mPitchBendHardware.store(x * 2.0f, std::memory_order_relaxed);
    }
    JNIEXPORT void JNICALL Java_com_example_audio_oboe_OboeAudioEngine_setNoteTuning(JNIEnv* env, jobject thiz, jint idx, jfloat cent) {
        if (korgEngineInstance && idx >= 0 && idx < MATRIX_NOTE_COUNT) korgEngineInstance->mOrientalTuningCents[idx].store(cent, std::memory_order_relaxed);
    }
    JNIEXPORT jint JNICALL Java_com_example_audio_oboe_OboeAudioEngine_processAudioForScale(JNIEnv* env, jobject thiz, jfloatArray audioChunk, jint size) {
        if (!gPitchDetector || !gDrummerInstance) return -1;
        jfloat* rawAudio = env->GetFloatArrayElements(audioChunk, nullptr);
        float hz = gPitchDetector->detectFundamentalFrequency(rawAudio, size);
        int32_t detectedMidiNote = gPitchDetector->convertHzToMidiNote(hz);
        env->ReleaseFloatArrayElements(audioChunk, rawAudio, JNI_ABORT);
        if (detectedMidiNote > 0) gDrummerInstance->notifyRightHandStrike(1.0f);
        return detectedMidiNote;
    }
