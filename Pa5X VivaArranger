constexpr int32_t MATRIX_NOTE_COUNT = 12;
constexpr float GAIN_SMOOTHING_FACTOR = 0.005f; 

struct PCMAsset { float* pcmBuffer = nullptr; int32_t totalSamples = 0; };
struct ActiveVoice {
    PCMAsset sample; float readIndex = 0.0f; float pitchRatio = 1.0f; int32_t targetChannel = 0; int32_t midiNote = 60;
    bool isLooping = false; int32_t loopStart = 0; int32_t loopEnd = 0; std::atomic<bool> inUse{false};
    float currentReleaseGain = 1.0f; bool isReleased = false;
    void clear() { inUse.store(false, std::memory_order_release); }
};
struct ChannelStrip { std::atomic<float> targetGain{1.0f}; float currentGain = 1.0f; std::atomic<bool> mute{false}; };

class Pa5xAdvancedEngine : public oboe::AudioStreamCallback {
public:
    ActiveVoice mVoicePool[MAX_POLYPHONY]; ChannelStrip mChannels[TOTAL_CHANNELS];
    std::atomic<float> mOrientalTuningCents[MATRIX_NOTE_COUNT]; std::atomic<float> mPitchBendHardware{0.0f};
    std::shared_ptr<oboe::AudioStream> mStream;

    Pa5xAdvancedEngine() {
        for (int i = 0; i < MATRIX_NOTE_COUNT; ++i) mOrientalTuningCents[i].store(0.0f);
        for (int i = 0; i < MAX_POLYPHONY; ++i) mVoicePool[i].inUse.store(false);
    }
    void startStream() {
        oboe::AudioStreamBuilder builder;
        builder.setDirection(oboe::Direction::Output)->setPerformanceMode(oboe::PerformanceMode::LowLatency)
               ->setSharingMode(oboe::SharingMode::Exclusive)->setFormat(oboe::AudioFormat::Float)
               ->setChannelCount(oboe::ChannelCount::Stereo)->setCallback(this)->openStream(mStream);
        if (mStream) mStream->requestStart();
    }
    void triggerVoice(float* buffer, int32_t length, int32_t channel, int32_t note, float velocity, bool loop, int32_t lStart, int32_t lEnd) {
        int32_t idx = -1;
        for (int i = 0; i < MAX_POLYPHONY; ++i) { if (!mVoicePool[i].inUse.load(std::memory_order_relaxed)) { idx = i; break; } }
        if (idx == -1) idx = 0;
        ActiveVoice& v = mVoicePool[idx]; v.sample.pcmBuffer = buffer; v.sample.totalSamples = length; v.readIndex = 0.0f;
        v.targetChannel = channel; v.midiNote = note; v.isLooping = loop; v.loopStart = lStart; v.loopEnd = lEnd;
        v.isReleased = false; v.currentReleaseGain = 1.0f; v.pitchRatio = std::exp2((note - 60) / 12.0f) * velocity;
        v.inUse.store(true, std::memory_order_release);
    }
    void releaseVoice(int32_t note) {
        for (int i = 0; i < MAX_POLYPHONY; ++i) { if (mVoicePool[i].inUse.load(std::memory_order_relaxed) && mVoicePool[i].midiNote == note) mVoicePool[i].isReleased = true; }
    }
    oboe::DataCallbackResult onAudioReady(oboe::AudioStream *audioStream, void *audioData, int32_t numFrames) override {
        float* output = static_cast<float*>(audioData); std::fill_n(output, numFrames * 2, 0.0f);
        float bend = mPitchBendHardware.load(std::memory_order_relaxed);
        for (int f = 0; f < numFrames; ++f) {
            float accL = 0.0f; float accR = 0.0f;
            for (int c = 0; c < TOTAL_CHANNELS; ++c) { float tg = mChannels[c].targetGain.load(std::memory_order_relaxed); mChannels[c].currentGain += (tg - mChannels[c].currentGain) * GAIN_SMOOTHING_FACTOR; }
            for (int v = 0; v < MAX_POLYPHONY; ++v) {
                ActiveVoice& voice = mVoicePool[v]; if (!voice.inUse.load(std::memory_order_acquire)) continue;
                int32_t nb = voice.midiNote % 12; float shift = mOrientalTuningCents[nb].load(std::memory_order_relaxed) / 100.0f;
                float step = voice.pitchRatio * std::exp2((shift + bend) / 12.0f);
                int32_t idxInt = static_cast<int32_t>(voice.readIndex);
                if (idxInt >= voice.sample.totalSamples) { voice.clear(); continue; }
                if (voice.isReleased) { voice.currentReleaseGain *= 0.995f; if (voice.currentReleaseGain < 0.001f) { voice.clear(); continue; } }
                float currentSample = voice.sample.pcmBuffer[idxInt]; float vol = mChannels[voice.targetChannel].currentGain * voice.currentReleaseGain;
                accL += currentSample * vol; accR += currentSample * vol; voice.readIndex += step;
                if (voice.isLooping && voice.readIndex >= voice.loopEnd) voice.readIndex = static_cast<float>(voice.loopStart);
            }
            output[f * 2] = std::clamp(accL * 0.70f, -1.0f, 1.0f); output[f * 2 + 1] = std::clamp(accR * 0.70f, -1.0f, 1.0f);
        }
        return oboe::DataCallbackResult::Continue;
    }
};
static Pa5xAdvancedEngine* gEngineInstance = nullptr;
extern "C" {
    JNIEXPORT void JNICALL Java_com_example_audio_oboe_OboeAudioEngine_initEngine(JNIEnv* env, jobject thiz) { if (gEngineInstance == nullptr) { gEngineInstance = new Pa5xAdvancedEngine(); gEngineInstance->startStream(); } }
    JNIEXPORT void JNICALL Java_com_example_audio_oboe_OboeAudioEngine_setChannelVol(JNIEnv* env, jobject thiz, jint ch, jfloat vol) { if (gEngineInstance && ch < TOTAL_CHANNELS) gEngineInstance->mChannels[ch].targetGain.store(vol, std::memory_order_relaxed); }
    JNIEXPORT void JNICALL Java_com_example_audio_oboe_OboeAudioEngine_updateJoystickHardware(JNIEnv* env, jobject thiz, jfloat x, jfloat y) { if (gEngineInstance) gEngineInstance->mPitchBendHardware.store(x * 2.0f, std::memory_order_relaxed); }
    JNIEXPORT void JNICALL Java_com_example_audio_oboe_OboeAudioEngine_setNoteTuning(JNIEnv* env, jobject thiz, jint idx, jfloat cent) { if (gEngineInstance && idx >= 0 && idx < MATRIX_NOTE_COUNT) gEngineInstance->mOrientalTuningCents[idx].store(cent, std::memory_order_relaxed); }
    JNIEXPORT void JNICALL Java_com_example_audio_oboe_OboeAudioEngine_releaseNativeNote(JNIEnv* env, jobject thiz, jint note) { if (gEngineInstance) gEngineInstance->releaseVoice(note); }
}
