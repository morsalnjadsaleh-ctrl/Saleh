    fun checkAndRequestStoragePermission() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
            if (!Environment.isExternalStorageManager()) {
                val intent = Intent(Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION).apply {
                    data = Uri.parse("package:${context.packageName}")
                    addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                }
                context.startActivity(intent)
            }
        }
    }

    /**
     * متد نهایی فرستادن مسیر باینری فایل کِرج به موتور نیتیو C++
     */
    fun loadKorgSetFromPath(absolutePath: String) {
        try {
            // ترفند مأمورایی: فایل KMP نقشه ساز را لود می‌کند و پوشه SOUND را به عنوان منبع نمونه‌ها برمی‌گزیند
            val folderPath = absolutePath.substringBeforeLast("/")
            
            // فراخوانی مستقیم پُل باینری JNI فازهای قبل برای لود ساز ارجینال کرگ
            val method = audioEngine.javaClass.getDeclaredMethod(
                "loadDirectKmpInstrument", 
                String::class.java, 
                String::class.java
            )
            method.isAccessible = true
            val success = method.invoke(audioEngine, absolutePath, folderPath) as Boolean
            
            if (success) {
                Log.i("KorgLoader", "سِت ارجینال کرگ با موفقیت مانند سخت‌افزار واقعی لود شد!")
            } else {
                Log.e("KorgLoader", "خطا در ساختار باینری فایل سِت.")
            }
        } catch (e: Exception) {
            e.printStackTrace()
        }
    }
}
