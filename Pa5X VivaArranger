#include <ctime>

// تنظیمات مهندسی بر اساس ساختار EDS-XP کیبورد Pa5X
constexpr int32_t MAX_POLYPHONY = 64;   // ۶۴ صدای هم‌زمان واقعی
constexpr int32_t TOTAL_CHANNELS = 4;   // لایه‌های میکس صوتی تفکیکی
constexpr int32_t MATRIX_NOTE_COUNT = 12;
constexpr float AMBIENT_SAMPLE_RATE = 44100.0f;
constexpr float GAIN_SMOOTHING_FACTOR = 0.005f; // فاکتور حذف پق‌پق صوتی (Anti-Click)

struct PCMAsset {
    float* pcmBuffer = nullptr;
    int32_t totalSamples = 0;
};

// ساختار پیشرفته صدا مجهز به فناوری SST (Smooth Sound Transition)
struct ActiveVoice {
    PCMAsset sample;
    float readIndex = 0.0f;
    float pitchRatio = 1.0f;
    int32_t targetChannel = 0;
    int32_t midiNote = 60;
    bool isLooping = false;
    int32_t loopStart = 0;
    int32_t loopEnd = 0;
    std::atomic<bool> inUse{false};
    
    // پارامترهای SST برای قطع نشدن ناگهانی دم صدا هنگام تغییر ساز
    float currentReleaseGain = 1.0f;
    bool isReleased = false;
};

struct ChannelStrip {
    std::atomic<float> targetGain{1.0f};
    float currentGain = 1.0f; // گین فعلی برای رمپینگ تدریجی و حذف کلیک
    std::atomic<bool> mute{false};
};

struct ChordSpecs {
    int32_t rootNote = 0;
    int32_t chordType = 0;
};

// موتور تشخیص فرکانس ملودی (Pitch Detection) با راندمان بالا
class Pa5xPitchDetector {
public:
    float detectFundamentalFrequency(const float* buffer, int32_t bufferSize) {
        int32_t maxLag = static_cast<int32_t>(AMBIENT_SAMPLE_RATE / 65);
        int32_t minLag = static_cast<int32_t>(AMBIENT_SAMPLE_RATE / 1046);
        float maxCorrelation = -1.0f;
        int32_t bestLag = -1;
        
        for (int32_t lag = minLag; lag < maxLag; ++lag) {
            float correlationSum = 0.0f;
            for (int32_t i = 0; i < bufferSize - lag; ++i) {
                correlationSum += buffer[i] * buffer[i + lag];
            }
            if (correlationSum > maxCorrelation) {
                maxCorrelation = correlationSum;
                bestLag = lag;
            }
        }
        return (bestLag > -1 && maxCorrelation > 0.1f) ? (AMBIENT_SAMPLE_RATE / bestLag) : 0.0f;
    }
    
    int32_t convertHzToMidiNote(float frequency) {
        if (frequency <= 0.0f) return -1;
        return static_cast<int32_t>(std::round(12.0f * std::log2(frequency / 440.0f) + 69.0f));
    }
};

// موتور درامر هوشمند تعاملی
class Pa5xSmartDrummer {
public:
    std::atomic<int32_t> mCurrentBpm{120};
    std::atomic<int32_t> mCurrentVariation{1};
    std::atomic<bool> mIsStylePlaying{false};
    std::atomic<int32_t> mRightHandNoteCount{0};
    unsigned long long mLastNoteTimestamp = 0;
    bool mCurrentPressedNotes = {false};
    ChordSpecs mDetectedChord;
    void notifyRightHandStrike(float velocity) {
        struct timespec ts;
        clock_gettime(CLOCK_MONOTONIC, &ts);
        unsigned long long currentMillis = (ts.tv_sec * 1000LL) + (ts.tv_nsec / 1000000LL);
        if (currentMillis - mLastNoteTimestamp < 250) {
            mRightHandNoteCount.store(mRightHandNoteCount.load() + 1, std::memory_order_relaxed);
        } else {
            mRightHandNoteCount.store(1, std::memory_order_relaxed);
        }
        mLastNoteTimestamp = currentMillis;
    }
};

// بدنه اصلی پردازش صوتی بدون نشت حافظه
class Pa5xAdvancedEngine {
public:
    ActiveVoice mVoicePool[MAX_POLYPHONY];
    ChannelStrip mChannels[TOTAL_CHANNELS];
    std::atomic<float> mOrientalTuningCents[MATRIX_NOTE_COUNT];
    std::atomic<float> mPitchBendHardware{0.0f};
    Pa5xAdvancedEngine() {
        for (int i = 0; i < MATRIX_NOTE_COUNT; ++i) mOrientalTuningCents[i].store(0.0f);
        for (int i = 0; i < MAX_POLYPHONY; ++i) mVoicePool[i].inUse.store(false);
    }

    void allocationVoiceTrigger(float* buffer, int32_t length, int32_t channel, int32_t note, float velocity, bool loop, int32_t lStart, int32_t lEnd) {
        int32_t targetIndex = -1;
        for (int i = 0; i < MAX_POLYPHONY; ++i) {
            if (!mVoicePool[i].inUse.load(std::memory_order_relaxed)) {
                targetIndex = i;
                break;
            }
        }
        if (targetIndex == -1) targetIndex = 0; 
        
        ActiveVoice& voice = mVoicePool[targetIndex];
        voice.sample.pcmBuffer = buffer;
        voice.sample.totalSamples = length;
        voice.readIndex = 0.0f;
        voice.targetChannel = channel;
        voice.midiNote = note;
        voice.isLooping = loop;
        voice.loopStart = lStart;
        voice.loopEnd = lEnd;
        voice.isReleased = false;
        voice.currentReleaseGain = 1.0f;
        voice.pitchRatio = std::pow(2.0f, (note - 60) / 12.0f) * velocity;
        voice.inUse.store(true, std::memory_order_release);
    }

    void processAudioFrames(float* outputBuffer, int32_t numFrames) {
        std::fill_n(outputBuffer, numFrames * 2, 0.0f);
        for (int f = 0; f < numFrames; ++f) {
            float accLeft = 0.0f;
            float accRight = 0.0f;
            for (int v = 0; v < MAX_POLYPHONY; ++v) {
                ActiveVoice& voice = mVoicePool[v];
                if (!voice.inUse.load(std::memory_order_relaxed)) continue;
                ChannelStrip& channel = mChannels[voice.targetChannel];
                if (channel.mute.load(std::memory_order_relaxed)) continue;

                int32_t noteBase = voice.midiNote % 12;
                float tuningShift = mOrientalTuningCents[noteBase].load(std::memory_order_relaxed) / 100.0f;
                float hardwareBend = mPitchBendHardware.load(std::memory_order_relaxed);
                float dynamicPitchStep = voice.pitchRatio * std::pow(2.0f, (tuningShift + hardwareBend) / 12.0f);

                int32_t indexInteger = static_cast<int32_t>(voice.readIndex);
                if (indexInteger >= voice.sample.totalSamples) {
                    voice.inUse.store(false, std::memory_order_release);
                    continue;
                }
                float currentSample = voice.sample.pcmBuffer[indexInteger];
                float targetG = channel.targetGain.load(std::memory_order_relaxed);
                if (channel.currentGain != targetG) {
                    channel.currentGain += (targetG - channel.currentGain) * GAIN_SMOOTHING_FACTOR;
                }
                if (voice.isReleased) {
                    voice.currentReleaseGain *= 0.995f;
                    if (voice.currentReleaseGain < 0.001f) {
                        voice.inUse.store(false, std::memory_order_release);
                        continue;
                    }
                }
                float finalVolume = channel.currentGain * voice.currentReleaseGain;
                accLeft += currentSample * finalVolume;
                accRight += currentSample * finalVolume;
                voice.readIndex += dynamicPitchStep;
            }
            outputBuffer[f * 2] = std::clamp(accLeft * 0.70f, -1.0f, 1.0f);
            outputBuffer[f * 2 + 1] = std::clamp(accRight * 0.70f, -1.0f, 1.0f);
        }
    }
};

