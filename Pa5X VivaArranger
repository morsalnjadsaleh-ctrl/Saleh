// ساختار استاندارد خواندن فریم‌های فایل صوتی بارگذاری شده کاربر برای برش زنده
struct AudioTrimSpecs {
    int32_t startFrame; // فریم شروع برش ملودی توسط لغزنده‌های کاربر
    int32_t endFrame;   // فریم پایان بخش ملودی اصلی
    float playbackSpeed; // سرعت پخش پیش‌فرض (مثلاً 0.5x یا 0.75x برای آموزش)
};
class Pa5xMelodyCutter {
public:
    // ۱. متد بومی برش ریل‌تایم بافر صوتی بدون کپی کردن دیتای اضافی در حافظه رم
    bool trimAudioPayload(const float* sourceBuffer, int32_t totalSourceFrames, 
                          AudioTrimSpecs specs, float* targetBuffer, int32_t& outTargetFrames) {
        
        if (specs.startFrame < 0 || specs.endFrame >= totalSourceFrames || specs.startFrame >= specs.endFrame) {
            return false;
        }

        int32_t requestedFrames = specs.endFrame - specs.startFrame;
        outTargetFrames = requestedFrames;

        // کپی فوق‌سریع فریم‌های برش‌خورده به بافر پردازش هوش صوتی با دستور memcpy
        std::memcpy(targetBuffer, sourceBuffer + (specs.startFrame * 2), requestedFrames * 2 * sizeof(float));
        return true;
    }
};

