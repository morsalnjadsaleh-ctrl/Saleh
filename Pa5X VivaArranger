    JNIEXPORT jint JNICALL Java_com_example_audio_oboe_OboeAudioEngine_analyzeScaleFromMelodyNative(
        JNIEnv* env, jobject thiz, jintArray notesArray, jint count) {
        
        if (!gScaleInterpreterInstance) return 0;
        
