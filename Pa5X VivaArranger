package com.example.audio.oboe

import android.content.Context
import android.media.midi.*
import android.os.*
class Pa5xHardwareMidiDriver(private val context: Context, private val audioEngine: OboeAudioEngine) {
private var mm: MidiManager? = context.getSystemService(Context.MIDI_SERVICE) as? MidiManager
init { scan() }
fun scan() { val m = mm ?: return; for (i in m.devices) { m.openDevice(i, { d -> if (d != null) d.openOutputPort(0)?.connect(KorgMidiReceiver()) }, Handler(Looper.getMainLooper())) } }
inner class KorgMidiReceiver : MidiReceiver() { override fun onSend(msg: ByteArray, offset: Int, count: Int, timestamp: Long) { if (count < 3) return; val c = msg[offset].toInt() and 0xF0; val n = msg[offset + 1].toInt() and 0x7F; val v = msg[offset + 2].toInt() and 0x7F; if (c == 0x90 && v > 0) {} else if (c == 0x80 || (c == 0x90 && v == 0)) { audioEngine.releaseLiveNote(n) } } }
}
