    void releaseVoice(int32_t n) { for (int i = 0; i < MAX_POLYPHONY; ++i) { if (mVoicePool[i].inUse.load(std::memory_order_relaxed) && mVoicePool[i].midiNote == n) mVoicePool[i].isReleased = true; } }
    oboe::DataCallbackResult onAudioReady(oboe::AudioStream *as, void *audioData, int32_t numFrames) override {
