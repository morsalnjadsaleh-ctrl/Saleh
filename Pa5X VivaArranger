app/src/main/AndroidManifest.xmlpackage com.example.audio.oboe

import android.content.Context
import android.media.MediaCodec
import android.media.MediaExtractor
import android.media.MediaFormat
import java.io.File
import java.nio.ByteBuffer
import java.nio.ByteOrder
import kotlin.concurrent.thread

class OboeAudioEngine(private val context: Context) {
    init {
        // بارگذاری و قفل کردن کتابخانه صوتی بومی فاز ۱ و ۲ در حافظه رم گوشی
        System.loadLibrary("pa5x_oboe")
        initEngine()
    }

    // --- لایه معرفی توابع بومی (C++) به زبان کاتلین ---
    private external fun initEngine()
    private external fun triggerNativeSample(ch: Int, arr: FloatArray, len: Int, note: Int, velocity: Float, lp: Boolean, start: Int, end: Int)
    private external fun updateJoystickHardware(x: Float, y: Float)
    private external fun setNoteTuning(idx: Int, cent: Float)
    private external fun setChannelVol(chId: Int, vol: Float)
    external fun processAudioForScale(audioChunk: FloatArray, size: Int): Int

    // --- توابع رابط کاربری جهت دسترسی و فرمان دادن به بخش بومی ---
    fun updateJoystick(x: Float, y: Float) = updateJoystickHardware(x, y)
    fun setNoteTuningCent(idx: Int, cent: Float) = setNoteTuning(idx, cent)
    fun setChannelVolume(ch: Int, vol: Float) = setChannelVol(ch, vol)

    /**
     * سیستم ریل‌تایم و سخت‌افزاری رمزگشایی فایل‌های صوتی فشرده سِت‌ها.
     * این متد فایلهای صوتی را باز کرده و دیتای خام را بدون سربار و به صورت ۳۲ بیتی اعشاری
     * مستقیم به رم موتور صوتی فاز ۱ پمپ می‌کند تا مشکل کرش کردن ارگ ۲۴ هرگز رخ ندهد.
     */
    fun loadCompressedAsset(assetName: String, channel: Int, note: Int, velocity: Float, loop: Boolean) {
        thread(start = true, name = "VivaDecoderThread") {
            try {
                val assetDescriptor = context.assets.openFd(assetName)
                val extractor = MediaExtractor()
                extractor.setDataSource(assetDescriptor.fileDescriptor, assetDescriptor.startOffset, assetDescriptor.length)
                extractor.selectTrack(0)
                
                val format = extractor.getTrackFormat(0)
                // اجبار رمزگشای اندروید برای تولید کیفیت ۳۲ بیت فلوت استودیویی پا ۵ ایکس
                format.setInteger(MediaFormat.KEY_PCM_ENCODING, android.media.AudioFormat.ENCODING_PCM_FLOAT)
                
                val codec = MediaCodec.createDecoderByType(format.getString(MediaFormat.KEY_MIME)!!)
                codec.configure(format, null, null, 0)
                codec.start()

                val info = MediaCodec.BufferInfo()
                val chunkData = mutableListOf<Float>()
                var isEOS = false

                // حلقه فوق سریع استخراج و دیکود فریم‌ها در دامنه سخت‌افزار گوشی
                while (!isEOS) {
                    val inIdx = codec.dequeueInputBuffer(1000)
                    if (inIdx >= 0) {
                        val buf = codec.getInputBuffer(inIdx)!!
                        val size = extractor.readSampleData(buf, 0)
                        if (size < 0) {
                            codec.queueInputBuffer(inIdx, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
                        } else {
                            codec.queueInputBuffer(inIdx, 0, size, extractor.sampleTime, 0)
                            extractor.advance()
                        }
                    }
                    val outIdx = codec.dequeueOutputBuffer(info, 1000)
                    if (outIdx >= 0) {
                        val outBuf = codec.getOutputBuffer(outIdx)!!
                        outBuf.order(ByteOrder.nativeOrder())
                        val floatBuf = outBuf.asFloatBuffer()
                        while (floatBuf.hasRemaining()) {
                            chunkData.add(floatBuf.get())
                        }
                        codec.releaseOutputBuffer(outIdx, false)
                        if ((info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0) {
                            isEOS = true
                        }
                    }
                }
                
                // پاکسازی و آزاد کردن آنی رم سخت‌افزار پس از اتمام دکود
                codec.stop()
                codec.release()
                extractor.release()
                assetDescriptor.close()

                val payload = chunkData.toFloatArray()
                // شلیک دیتای رمزگشایی شده به پولیفونی ۶۴ کاناله C++
                triggerNativeSample(channel, payload, payload.size, note, velocity, loop, 0, payload.size - 1)
            } catch (e: Exception) { 
                e.printStackTrace() 
            }
        }
    }
}

