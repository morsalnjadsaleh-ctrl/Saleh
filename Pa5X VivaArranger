class Pa5xScaleInterpreter {
public:
    // ۲. مفسر هوشمند دستگاه موسیقی ایرانی بر اساس آرایه‌ای از نت‌های کشف شده در ملودی کاربر
    int32_t matchTraditionalScale(const int32_t* uniqueNotes, int32_t count) {
        if (count < 3) return 0; // دیتای ناکافی برای تحلیل گام

        int32_t noteMask = 0;
        for (int i = 0; i < count; ++i) {
            if (uniqueNotes[i] >= 0) {
                noteMask |= (1 << (uniqueNotes[i] % 12));
            }
        }

        // ماسک‌های بیتی ثابت فواصل ۱۲ نت اکتساو دستگاه‌های موسیقی (0=Do, 1=C#, 2=Re, ...)
        int32_t shurSolMask = (1 << 7) | (1 << 8) | (1 << 10) | (1 << 0) | (1 << 2); // شور سل (با فرض لا کرن و می کرن)
        int32_t homayounDoMask = (1 << 0) | (1 << 1) | (1 << 4) | (1 << 5) | (1 << 7) | (1 << 8); // همایون/اصفهان دو
        int32_t mahoorCMask = (1 << 0) | (1 << 2) | (1 << 4) | (1 << 5) | (1 << 7) | (1 << 9) | (1 << 11); // ماهور دو ماژور
        if ((noteMask & shurSolMask) == shurSolMask) return 1;       // شناسایی دستگاه شور
        if ((noteMask & homayounDoMask) == homayounDoMask) return 2; // شناسایی همایون / اصفهان
        if ((noteMask & mahoorCMask) == mahoorCMask) return 3;       // شناسایی دستگاه ماهور

        return 0; // گام آزاد یا ناشناخته
    }
};

static Pa5xScaleInterpreter* gScaleInterpreterInstance = nullptr;

extern "C" {
    JNIEXPORT void JNICALL Java_com_example_audio_oboe_OboeAudioEngine_initMelodyAnalyzer(JNIEnv* env, jobject thiz) {
        if (gMelodyCutterInstance == nullptr) gMelodyCutterInstance = new Pa5xMelodyCutter();
        if (gScaleInterpreterInstance == nullptr) gScaleInterpreterInstance = new Pa5xScaleInterpreter();
