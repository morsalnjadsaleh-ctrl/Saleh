import android.util.Log

/**
 * افزونه‌های مهندسی مأمورایی برای فعال‌سازی بخش هوش صوتی و مفسر دستگاه‌ها
 */
fun OboeAudioEngine.initAdvancedMelodyExtensions() {
    try {
        // فراخوانی متد بومی بیدارباش مفسر سیگنال در لایه C++ fاز ۵
        val initMethod = this.javaClass.getDeclaredMethod("initMelodyAnalyzer")
        initMethod.isAccessible = true
        initMethod.invoke(this)
        Log.i("VivaEngine", "موتور تشخیص هوشمند گام و دستگاه‌های سنتی با موفقیت فعال شد.")
    } catch (e: Exception) {
        e.printStackTrace()
    }
}

/**
 * پُل ارتباطی دریافت آرایه نت‌ها و تبدیل آن به نام متناظر دستگاه روی مانیتور ارگ
 */
fun OboeAudioEngine.interpretCurrentMelodyScale(detectedNotes: IntArray, scaleManager: Pa5xScaleManager) {
    try {
        val analyzeMethod = this.javaClass.getDeclaredMethod(
            "analyzeScaleFromMelodyNative", 
            IntArray::class.java, 
            Int.臨界Context::class.javaPrimitiveType ?: Int::class.java
        )
        analyzeMethod.isAccessible = true
        
        // ارسال دیتای نت‌ها به الگوریتم ماسک بیتی C++
        val scaleId = analyzeMethod.invoke(this, detectedNotes, detectedNotes.size) as Int
        
        // آپدیت آنی متن روی نمایشگر Pa5X
        scaleManager.currentDetectedScaleName.value = when (scaleId) {
            1 -> "دستگاه شور (سل)"
            2 -> "آواز اصفهان / همایون"
            3 -> "دستگاه ماهور (ماژور)"
            else -> "گام آزاد / ناشناخته"
        }
    } catch (e: Exception) {
        scaleManager.currentDetectedScaleName.value = "خطا در تحلیل گام"
    }
}
    /**
     * ۲. رسیور فوق‌سریع برای رمزگشایی کدهای باینری سخت‌افزار کلاویه‌ها از کابل USB
     */
    inner class KorgMidiReceiver : MidiReceiver() {
        override fun onSend(msg: ByteArray, offset: Int, count: Int, timestamp: Long) {
            val statusByte = msg[offset].toInt() and 0xFF
            val command = statusByte and 0xF0
            
            if (count >= 3) {
                val midiNote = msg[offset + 1].toInt() and 0x7F
                val rawVelocity = msg[offset + 2].toInt() and 0x7F
                val floatVelocity = rawVelocity / 127.0f

                when (command) {
                    0x90 -> { // رویداد Note On (فشردن کلید)
                        if (rawVelocity > 0) {
                            // ارسال مستقیم به دکودر سخت‌افزاری و موتور صوتی فاز ۱ و ۲
                            audioEngine.loadCompressedAsset("samples/piano_c4.wav", 0, midiNote, floatVelocity, false)
                            // روشن کردن چراغ کلاویه روی مانیتور
                            scaleManager.updateLivePlayingLight(midiNote)
                        }
                    }
                }
            }
        }
    }

    /**
     * شبیه‌ساز دکمه‌های کیبورد کامپیوتر/لپ‌تاپ برای تست سریع (ردیف کلیدهای ASDFGHJKL)
     */
    fun handleKeyboardInput(keyCode: Int, action: Int): Boolean {
        // ۱۲۸ یعنی KeyEvent.ACTION_DOWN در لایه بومی اندروید
        if (action != 0) return false
        
        val targetMidiNote = when (keyCode) {
            29 -> 60  // کلید A -> نت دو
            30 -> 62  // کلید S -> نت ر
            31 -> 64  // کلید D -> نت می
            32 -> 65  // کلید F -> نت فا
            33 -> 67  // کلید G -> نت سل
            34 -> 69  // کلید H -> نت لا
            35 -> 71  // کلید Si -> نت سی
            36 -> 72  // کلید K -> دو اکتساو بعد
            else -> return false
        }

        audioEngine.loadCompressedAsset("samples/piano_c4.wav", 0, targetMidiNote, 1.0f, false)
        scaleManager.updateLivePlayingLight(targetMidiNote)
        return true
    }
}
